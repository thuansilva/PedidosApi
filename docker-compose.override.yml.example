services:

  pedidos-api:
    # Porta alternativa — útil se 5010 já estiver ocupada
    ports:
      - "5010:8080"

    # Descomente para sobrescrever variáveis individualmente
    # environment:
    #   - FeatureManagement__NovoCalculoFrete=false
